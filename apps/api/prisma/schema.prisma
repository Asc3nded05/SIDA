generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  LEADERSHIP
}

enum WorkStatus {
  PENDING
  APPROVED
  DENIED
}

enum CommissionStatus {
  SUBMITTED
  REVIEWING
  MATCHED
  IN_PROGRESS
  COMPLETED
  DECLINED
}

model Member {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  passwordHash String
  role         Role        @default(MEMBER)
  title        String?
  bio          String?
  disciplines  String[]
  profileImage String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  works        Work[]
  commissionAssignments CommissionAssignment[]
}

model Work {
  id                 String     @id @default(cuid())
  memberId           String
  member             Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  commissionRequestId String?
  commissionRequest  CommissionRequest? @relation(fields: [commissionRequestId], references: [id], onDelete: SetNull)
  title              String
  description        String?
  category           String
  mediaUrl           String
  thumbnailUrl       String?
  status             WorkStatus @default(PENDING)
  reviewedAt         DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  comments           Comment[]

  @@index([memberId])
  @@index([commissionRequestId])
  @@index([status, createdAt])
}

model CommissionRequest {
  id           String           @id @default(cuid())
  title        String
  description  String
  requirements String?
  contactName  String
  contactEmail String
  category     String
  timeline     String?
  dueDate      DateTime?
  assignments  CommissionAssignment[]
  works        Work[]
  status       CommissionStatus @default(SUBMITTED)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status, createdAt])
}

model CommissionAssignment {
  id                  String            @id @default(cuid())
  commissionRequestId String
  memberId            String
  assignedAt          DateTime          @default(now())

  commissionRequest CommissionRequest @relation(fields: [commissionRequestId], references: [id], onDelete: Cascade)
  member            Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([commissionRequestId, memberId])
  @@index([memberId])
}

model Comment {
  id        String   @id @default(cuid())
  workId    String
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  author    String
  body      String
  createdAt DateTime @default(now())

  @@index([workId, createdAt])
}
